<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:title="@string/app_name"
            app:titleTextColor="@color/text"
            app:subtitleTextColor="@color/dim" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="24dp"
                android:text="@string/empty_hint"
                android:textColor="@color/dim"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="96dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Action Button for Adding Links -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="94dp"
        android:contentDescription="@string/add_link"
        app:backgroundTint="@color/accent"
        app:elevation="6dp"
        app:srcCompat="@drawable/ic_add"
        app:tint="@android:color/white" />

    <!-- Floating Frosted Glass Bottom Navigation Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_frosted_bottom_nav"
            android:elevation="8dp"
            app:elevation="8dp"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/selector_nav_item"
            app:itemPaddingBottom="6dp"
            app:itemPaddingTop="6dp"
            app:itemRippleColor="@color/accent_glow"
            app:itemTextColor="@color/selector_nav_item"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
    </FrameLayout>

</FrameLayout>
