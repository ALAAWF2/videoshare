<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Full-screen Touch / Gesture Overlay -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Center Transient / Persistent Indicators Layer -->
    <FrameLayout
        android:id="@+id/center_indicators_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <!-- Transient Seek Indicator (+5 ث / −5 ث) -->
        <TextView
            android:id="@+id/tv_indicator_seek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_indicator"
            android:gravity="center"
            android:minWidth="110dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+5 ث" />

        <!-- Live Gesture Indicator (Brightness ☀ 62%, Volume 🔊 80%, Scrub ▶ 12:34 / 45:00) -->
        <TextView
            android:id="@+id/tv_indicator_gesture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_indicator"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="☀ 62%" />

        <!-- Transient Speed Indicator (1.5×) -->
        <TextView
            android:id="@+id/tv_indicator_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_pill_indicator"
            android:gravity="center"
            android:minWidth="90dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1.5×" />

        <!-- Center Play/Pause Flash Indicator -->
        <ImageView
            android:id="@+id/iv_indicator_play_pause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_indicator"
            android:padding="18dp"
            android:src="@drawable/ic_play"
            android:visibility="gone"
            app:tint="@android:color/white" />

        <!-- Persistent Hold Speed Indicator (2× ⏩) -->
        <TextView
            android:id="@+id/tv_indicator_hold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:background="@drawable/bg_hold_indicator"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="2× ⏩" />

    </FrameLayout>

    <!-- Error Retry Panel Overlay -->
    <LinearLayout
        android:id="@+id/layout_error_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_pill_indicator"
        android:elevation="6dp"
        android:gravity="center"
        android:minWidth="260dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/play_error"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_error_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="@color/dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/accent"
                android:text="@string/retry"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Overlay Bar (Title, Sleep Pill, PiP, WatchParty, Settings) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_controls_top_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:navigationIcon="@drawable/ic_back"
            app:subtitleTextColor="@color/dim"
            app:titleTextColor="@color/text" />

        <!-- Sleep Timer Countdown Pill -->
        <TextView
            android:id="@+id/tv_sleep_timer_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="🌙 14:32" />

        <!-- Next Episode Button -->
        <ImageButton
            android:id="@+id/btn_next_episode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/next_episode"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next_episode"
            android:visibility="gone"
            app:tint="@color/text" />

        <!-- Sleep Timer Button -->
        <ImageButton
            android:id="@+id/btn_sleep"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/sleep_timer"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sleep"
            app:tint="@color/text" />

        <!-- Watch Party Button -->
        <ImageButton
            android:id="@+id/btn_watch_party"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/watch_party"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_watch_party"
            app:tint="@color/text" />

        <!-- Picture-in-Picture Button -->
        <ImageButton
            android:id="@+id/btn_pip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/pip_enter"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pip"
            app:tint="@color/text" />
    </LinearLayout>

    <!-- Flying Emojis Layer for Watch Party -->
    <FrameLayout
        android:id="@+id/flying_emoji_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Watch Party Quick Reaction Bar (Overlay) -->
    <LinearLayout
        android:id="@+id/layout_party_reactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_party_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="WP-1234" />

        <TextView
            android:id="@+id/btn_emoji_fire"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔥"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_emoji_heart"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="❤️"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_emoji_laugh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😂"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_emoji_popcorn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🍿"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Bottom Controls Overlay Bar -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_controls_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Seekbar Tooltip Bubble Container -->
        <FrameLayout
            android:id="@+id/layout_bubble_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="60dp"
            android:paddingEnd="60dp">

            <TextView
                android:id="@+id/tv_preview_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_bubble"
                android:elevation="4dp"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="14:25" />
        </FrameLayout>

        <!-- Time & SeekBar row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="50dp"
                android:text="00:00"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:progressBackgroundTint="@color/progress_bg"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="50dp"
                android:text="00:00"
                android:textColor="@color/dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Actions row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Speed Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_speed"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_pill"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="1×"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp" />

            <!-- Quality Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quality"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_pill"
                android:minWidth="52dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="6dp"
                android:text="AUTO"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Play / Pause Center Glass Button -->
            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/exo_controls_play"
                android:elevation="4dp"
                android:padding="16dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/text" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Settings Glass Button -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/dim" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
