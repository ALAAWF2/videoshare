<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header with Poster & Close Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/iv_details_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_movie" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_details_header_gradient" />

            <ImageButton
                android:id="@+id/btn_close_details"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_circle_indicator"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/text" />

            <!-- Poster overlay & Quick Info at bottom of header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="75dp"
                    android:layout_height="110dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_details_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_movie" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_details_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Meta Tags (Rating, Year, Duration) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_details_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rating_badge"
                            android:paddingStart="6dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="2dp"
                            android:text="★ 8.5"
                            android:textColor="#FFD700"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_details_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_indicator"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/dim"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_details_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_indicator"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/dim"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Main Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Play Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_details_play"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent"
                    android:text="@string/iptv_play_btn"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <!-- Download Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_details_download"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/card"
                    android:text="@string/download_action"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/accent" />

                <!-- Favorite Button -->
                <ImageButton
                    android:id="@+id/btn_details_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_indicator"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/dim" />

                <!-- Direct Link Button -->
                <ImageButton
                    android:id="@+id/btn_details_direct_link"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_indicator"
                    android:contentDescription="@string/iptv_direct_link"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_copy_link"
                    app:tint="@color/dim" />

                <!-- Watch Party Button -->
                <ImageButton
                    android:id="@+id/btn_details_watch_party"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_indicator"
                    android:contentDescription="@string/watch_party"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_watch_party"
                    app:tint="@color/accent" />

            </LinearLayout>

            <!-- Series: View Episodes Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_details_view_episodes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="@string/details_view_episodes"
                android:textColor="@color/accent"
                android:visibility="gone"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_series"
                app:iconGravity="textStart"
                app:iconTint="@color/accent"
                app:strokeColor="@color/accent" />

            <!-- Genre -->
            <TextView
                android:id="@+id/tv_details_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Plot / Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/details_plot"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_details_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/details_no_plot"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <!-- Cast -->
            <TextView
                android:id="@+id/tv_details_cast_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/details_cast"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_details_cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dim"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Loading Indicator for extra info -->
            <ProgressBar
                android:id="@+id/progress_details_loading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
