<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- Header Title & Subtitle -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/iptv_mirror_check_title"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dim"
        android:textSize="13sp"
        android:text="@string/iptv_mirror_probing" />

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/progress_bg"
        app:trackCornerRadius="4dp" />

    <!-- List of probed mirrors -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_mirrors"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- All-fail Explanatory Panel (hidden while probing, shown if 0 working) -->
    <LinearLayout
        android:id="@+id/layout_all_fail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_status_blocked"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_all_fail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/iptv_mirror_none_ok"
            android:textColor="@color/status_blocked_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_all_fail_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/iptv_blocked_description"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_warp_diag"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/iptv_how_to_install_warp"
                android:textColor="@color/accent"
                android:textSize="12sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry_diag"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/iptv_retry_probe"
                android:textColor="@color/text"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/dim" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Buttons Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:text="@string/iptv_close"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_use_working"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:enabled="false"
            android:text="@string/iptv_mirror_use_working"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            app:backgroundTint="@color/accent"
            app:cornerRadius="21dp" />
    </LinearLayout>

</LinearLayout>
